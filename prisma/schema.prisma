generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id
  name          String
  email         String
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  role          String            @default("member")
  banned        Boolean?          @default(false)
  banReason     String?
  banExpires    DateTime?         @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  createdSpaces Space[]
  memberships   SpaceMembership[]
  createdDocuments Document[] @relation("DocumentCreator")
  archivedDocuments Document[] @relation("DocumentArchiver")
  authoredRevisions DocumentRevision[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Space {
  id          String            @id @db.Uuid
  name        String            @db.VarChar(200)
  createdBy   String
  creator     User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  lockVersion Int               @default(1)
  memberships SpaceMembership[]
  documents   Document[]
}

model SpaceMembership {
  spaceId   String   @db.Uuid
  userId    String
  role      String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([spaceId, userId])
  @@index([userId, spaceId])
}

model Document {
  id                    String             @id @db.Uuid
  spaceId               String             @db.Uuid
  space                 Space              @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  currentRevisionNumber Int
  head                  DocumentRevision   @relation("DocumentHead", fields: [id, currentRevisionNumber], references: [documentId, revisionNumber], onDelete: NoAction, onUpdate: NoAction)
  lockVersion           Int                @default(1)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  createdBy             String
  creator               User               @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?          @db.Timestamptz(3)
  archivedBy            String?
  archiver              User?              @relation("DocumentArchiver", fields: [archivedBy], references: [id], onDelete: Restrict)
  revisions             DocumentRevision[] @relation("DocumentHistory")

  @@index([spaceId, archivedAt, id])
}

model DocumentRevision {
  id                   String     @id @db.Uuid
  documentId           String     @db.Uuid
  document             Document   @relation("DocumentHistory", fields: [documentId], references: [id], onDelete: Restrict)
  revisionNumber       Int
  title                String     @db.VarChar(200)
  contentFormat        String
  contentSchemaVersion Int
  contentEditorVersion String?
  body                 Json       @db.JsonB
  plainText            String
  // Reviewed SQL owns this stored generated column and its GIN index.
  searchVector         Unsupported("tsvector") @default(dbgenerated())
  authorId             String
  author               User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  changeNote           String?    @db.VarChar(2000)
  headOf               Document[] @relation("DocumentHead")

  @@unique([documentId, revisionNumber])
}
