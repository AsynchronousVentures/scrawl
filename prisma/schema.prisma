generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id
  name          String
  email         String
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  role          String            @default("member")
  banned        Boolean?          @default(false)
  banReason     String?
  banExpires    DateTime?         @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  createdSpaces Space[]
  memberships   SpaceMembership[]
  createdDocuments Document[] @relation("DocumentCreator")
  archivedDocuments Document[] @relation("DocumentArchiver")
  authoredRevisions DocumentRevision[]
  uploadedAttachments Attachment[]
  publications Publication[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Space {
  id          String            @id @db.Uuid
  name        String            @db.VarChar(200)
  slug        String            @unique @db.VarChar(80)
  createdBy   String
  creator     User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  lockVersion Int               @default(1)
  memberships SpaceMembership[]
  documents   Document[]
}

model SpaceMembership {
  spaceId   String   @db.Uuid
  userId    String
  role      String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([spaceId, userId])
  @@index([userId, spaceId])
}

model Document {
  id                    String             @id @db.Uuid
  slug                  String             @db.VarChar(80)
  spaceId               String             @db.Uuid
  space                 Space              @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  currentRevisionNumber Int
  head                  DocumentRevision   @relation("DocumentHead", fields: [id, currentRevisionNumber], references: [documentId, revisionNumber], onDelete: NoAction, onUpdate: NoAction)
  lockVersion           Int                @default(1)
  liveEpoch             String?            @db.Uuid
  liveRoom              DocumentLive?      @relation("CurrentLiveRoom", fields: [id, liveEpoch], references: [documentId, epoch], onDelete: NoAction, onUpdate: NoAction)
  liveRooms             DocumentLive[]     @relation("LiveRoomHistory")
  availabilityVersion   Int                @default(1)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  createdBy             String
  creator               User               @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?          @db.Timestamptz(3)
  archivedBy            String?
  archiver              User?              @relation("DocumentArchiver", fields: [archivedBy], references: [id], onDelete: Restrict)
  revisions             DocumentRevision[] @relation("DocumentHistory")
  attachments           Attachment[]
  publication           Publication?

  @@unique([spaceId, slug])
  @@index([spaceId, archivedAt, id])
}

model DocumentLive {
  documentId    String      @db.Uuid
  epoch         String      @db.Uuid
  document      Document    @relation("LiveRoomHistory", fields: [documentId], references: [id], onDelete: Restrict)
  sequence      BigInt      @default(0)
  schemaVersion Int         @default(1)
  state         Bytes       @db.ByteA
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  currentOf     Document[]  @relation("CurrentLiveRoom")

  @@id([documentId, epoch])
}

model DocumentRevision {
  id                   String     @id @db.Uuid
  documentId           String     @db.Uuid
  document             Document   @relation("DocumentHistory", fields: [documentId], references: [id], onDelete: Restrict)
  revisionNumber       Int
  title                String     @db.VarChar(200)
  contentFormat        String
  contentSchemaVersion Int
  contentEditorVersion String?
  body                 Json       @db.JsonB
  plainText            String
  // Reviewed SQL owns this stored generated column and its GIN index.
  searchVector         Unsupported("tsvector") @default(dbgenerated())
  authorId             String
  author               User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  changeNote           String?    @db.VarChar(2000)
  headOf               Document[] @relation("DocumentHead")
  attachments          RevisionAttachment[]
  publications         Publication[] @relation("PublishedRevision")

  @@unique([documentId, revisionNumber])
  @@unique([id, documentId])
}

model Attachment {
  id         String @id @db.Uuid
  documentId String @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  name       String @db.VarChar(200)
  mimeType   String @db.VarChar(100)
  size       Int
  sha256     String @db.VarChar(64)
  createdBy  String
  creator    User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  revisions  RevisionAttachment[]

  @@unique([id, documentId])
  @@index([documentId])
}

model RevisionAttachment {
  revisionId   String @db.Uuid
  attachmentId String @db.Uuid
  documentId   String @db.Uuid
  revision     DocumentRevision @relation(fields: [revisionId, documentId], references: [id, documentId], onDelete: Restrict)
  attachment   Attachment @relation(fields: [attachmentId, documentId], references: [id, documentId], onDelete: Restrict)

  @@id([revisionId, attachmentId])
}

model Publication {
  id                          String @id @db.Uuid
  documentId                  String @unique @db.Uuid
  document                    Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revisionNumber              Int
  revision                    DocumentRevision @relation("PublishedRevision", fields: [documentId, revisionNumber], references: [documentId, revisionNumber], onDelete: Restrict)
  approvedAvailabilityVersion Int
  active                      Boolean @default(true)
  publisherId                 String
  publisher                   User @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  publishedAt                 DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)
}
