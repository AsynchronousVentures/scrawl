# Local development only. Never use these example credentials for a real deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
API_DOCS_ENABLED=true
DB_POOL_MAX=5
# Application-owned private bytes. Never point this at a frontend/static directory.
ATTACHMENT_STORAGE_DIR=var/private-attachments
# Enabling this only permits explicit administrator approval of selected revisions.
PUBLIC_PUBLISHING_ENABLED=false
POSTGRES_USER=docs
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=docs
DATABASE_URL=postgresql://docs:dev-only-change-me@127.0.0.1:5432/docs

# Set a fresh random secret locally; do not copy a shared example value.
APP_ORIGIN=http://127.0.0.1:3000
AUTH_SECRET=
