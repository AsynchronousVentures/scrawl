{
  "name": "@asynchronous-ventures/scrawl-api",
  "version": "0.0.0",
  "private": true,
  "description": "Scrawl backend-first documentation platform foundation.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx --test test/integration/*.test.ts",
    "openapi:export": "node --import tsx scripts/export-openapi.ts",
    "check": "npm run check:boundaries && npm run typecheck && npm test && npm run build",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "operator": "node --env-file-if-exists=.env --import tsx scripts/operator.ts",
    "postinstall": "npm run db:generate",
    "check:boundaries": "node --import tsx scripts/check-boundaries.ts",
    "demo:init": "node --import tsx scripts/demo-fixtures.ts init",
    "demo:setup": "node --import tsx scripts/demo-fixtures.ts setup",
    "demo:reset": "node --import tsx scripts/demo-fixtures.ts reset",
    "demo:serve": "node --import tsx scripts/demo-server.ts",
    "demo:a": "node --import tsx scripts/demo-a.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "prosemirror-model": "1.25.12"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
