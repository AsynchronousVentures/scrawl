{
  "name": "@asynchronous-ventures/scrawl-api",
  "version": "0.0.0",
  "private": true,
  "description": "Scrawl backend-first documentation platform foundation.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx --test test/integration/*.test.ts",
    "openapi:export": "node --import tsx scripts/export-openapi.ts",
    "check": "npm run check:boundaries && npm run typecheck && npm run web:typecheck && npm test && npm run build && npm run web:build && npm run web:generate:check",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "operator": "node --env-file-if-exists=.env --import tsx scripts/operator.ts",
    "postinstall": "npm run db:generate",
    "check:boundaries": "node --import tsx scripts/check-boundaries.ts",
    "demo:init": "node --import tsx scripts/demo-fixtures.ts init",
    "demo:setup": "node --import tsx scripts/demo-fixtures.ts setup",
    "demo:reset": "node --import tsx scripts/demo-fixtures.ts reset",
    "demo:serve": "node --import tsx scripts/demo-server.ts",
    "demo:a": "node --import tsx scripts/demo-a.ts",
    "demo:b:seed": "node --import tsx scripts/demo-b.ts",
    "web:generate": "npm run openapi:export && openapi-typescript artifacts/openapi.json -o web/src/api/schema.d.ts --alphabetize",
    "web:generate:check": "npm run openapi:export && openapi-typescript artifacts/openapi.json -o web/src/api/schema.d.ts --alphabetize --check",
    "web:dev": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web && node --import tsx scripts/build-web-source.ts",
    "web:typecheck": "npm run typecheck --workspace web",
    "test:browser": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "demo:dev": "node --import tsx scripts/demo-dev.ts",
    "content:migrate": "node --env-file-if-exists=.env --import tsx scripts/content-upgrade.ts",
    "demo:workspace": "node --import tsx scripts/demo-workspace.ts",
    "search:rebuild": "node --env-file-if-exists=.env --import tsx scripts/search-index.ts rebuild",
    "demo:verify": "node --import tsx scripts/demo-verify.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/server-util": "0.55.0",
    "@blocknote/xl-docx-exporter": "0.55.0",
    "@blocknote/xl-pdf-exporter": "0.55.0",
    "@blocknote/xl-typst-compiler": "0.55.0",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.0",
    "@hocuspocus/server": "4.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "async-mutex": "0.5.0",
    "better-auth": "1.7.6",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "lib0": "0.2.119",
    "pg": "8.23.0",
    "prosemirror-model": "1.25.12",
    "sharp": "0.35.5",
    "ws": "8.22.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "jszip": "3.10.2",
    "openapi-typescript": "7.13.0",
    "pdfjs-dist": "6.3.289",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "workspaces": [
    "web"
  ]
}
